Select reviews_ribbit78.title, 
movies.director, movies.rating, reviews_ribbit78.rating
from movies
join reviews_ribbit78
on movies.title = reviews_ribbit78.title
where reviews_ribbit78.rating = 10 and movies.director in (select director from movies
Group by movies.director
HAving max(movies.rating) < 8.5);

